<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Bitácora de cambios (requisito 7). Solo administradores.
  Controlador: BitacoraController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.BitacoraController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Bitácora de cambios" styleClass="titulo-modulo"/>
    <Label styleClass="texto-secundario" wrapText="true"
           text="Cambios en campos sensibles (montos de donaciones, datos y calificaciones de adopciones, estados y recompensas de mascotas), del más reciente al más antiguo. Puede combinar cualquiera de los filtros."/>

    <!-- ====================================================================== -->
    <!-- ============================== Filtros =============================== -->
    <!-- ====================================================================== -->

    <VBox styleClass="panel-blanco" spacing="10">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14"/>
        </padding>
        <GridPane hgap="12" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            <Label text="Usuario" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Tabla" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Campo" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label text="Id del registro" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <TextField fx:id="txtUsuario" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbTabla" promptText="Todas" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <TextField fx:id="txtCampo" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtIdRegistro" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Texto en valores o descripción" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text="Desde" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Hasta" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextField fx:id="txtTexto" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <DatePicker fx:id="dpDesde" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <DatePicker fx:id="dpHasta" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="3">
                <Button text="Buscar" styleClass="boton-primario" defaultButton="true" onAction="#onBuscar"/>
                <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiar"/>
            </HBox>
        </GridPane>
    </VBox>

    <!-- ====================================================================== -->
    <!-- ============================= Resultados ============================= -->
    <!-- ====================================================================== -->

    <TableView fx:id="tblBitacora" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="130"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="90"/>
            <TableColumn fx:id="colTabla" text="Tabla" prefWidth="90"/>
            <TableColumn fx:id="colCampo" text="Campo" prefWidth="140"/>
            <TableColumn fx:id="colRegistro" text="Registro" prefWidth="70"/>
            <TableColumn fx:id="colAnterior" text="Valor anterior" prefWidth="130"/>
            <TableColumn fx:id="colNuevo" text="Valor nuevo" prefWidth="130"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
        </columns>
        <placeholder>
            <Label text="No hay cambios registrados con esos criterios."/>
        </placeholder>
    </TableView>

    <Label fx:id="lblTotalRegistros" styleClass="texto-total"/>
</VBox>
