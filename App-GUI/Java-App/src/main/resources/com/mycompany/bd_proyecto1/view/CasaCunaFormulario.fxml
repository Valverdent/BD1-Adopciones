<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Registro, edición y consulta de una casa cuna.
  Controlador: CasaCunaFormularioController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.bd_proyecto1.controller.CasaCunaFormularioController"
            fitToWidth="true" styleClass="scroll-pane">
    <VBox styleClass="contenido" spacing="12">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <Label fx:id="lblTitulo" text="Casa cuna" styleClass="titulo-modulo"/>
        <Label fx:id="lblDueno" styleClass="texto-secundario" wrapText="true"/>
        <Label fx:id="lblSoloLectura" styleClass="aviso-info" wrapText="true"
               text="Solo el dueño de la casa cuna o un administrador puede modificarla."/>

        <!-- ====================================================================== -->
        <!-- ========================== Datos de la casa ========================== -->
        <!-- ====================================================================== -->

        <VBox styleClass="panel-blanco" spacing="10">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>
            <Label text="Datos de la casa" styleClass="seccion-titulo"/>
            <GridPane hgap="12" vgap="4">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <Label text="Estado *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cmbEstado" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="Capacidad máxima de mascotas *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="Mascotas que tiene ahora" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <TextField fx:id="txtCapacidad" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <!-- Solo lectura: la base cuenta las mascotas asignadas a esta casa cuna -->
                <Label fx:id="lblActual" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <CheckBox fx:id="chkDonacion" text="Pide donación de alimentos para cuidar a la mascota"
                          GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"/>
            </GridPane>
            <Label fx:id="lblDisponible"/>
            <Label text="Lugar de la casa cuna" styleClass="seccion-titulo"/>
            <fx:include fx:id="ubicacion" source="UbicacionCampos.fxml"/>
        </VBox>

        <!-- ====================================================================== -->
        <!-- ================== Tamaños de mascota que acepta * =================== -->
        <!-- ====================================================================== -->

        <VBox styleClass="panel-blanco" spacing="10">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>
            <Label text="Tamaños de mascota que acepta *" styleClass="seccion-titulo"/>
            <HBox fx:id="boxTamanos" spacing="16"/>
        </VBox>

        <!-- ====================================================================== -->
        <!-- =================== Tipos de mascota que acepta * ==================== -->
        <!-- ====================================================================== -->

        <VBox styleClass="panel-blanco" spacing="10">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>
            <Label text="Tipos de mascota que acepta *" styleClass="seccion-titulo"/>
            <HBox fx:id="boxTipos" spacing="16"/>
        </VBox>

        <!-- ====================================================================== -->
        <!-- ============ Contacto (viene de los datos de la persona) ============= -->
        <!-- ====================================================================== -->

        <VBox styleClass="panel-blanco" spacing="6">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>
            <Label text="Contacto (viene de los datos de la persona)" styleClass="seccion-titulo"/>
            <Label fx:id="lblContacto" wrapText="true"/>
        </VBox>

        <HBox spacing="10">
            <Button fx:id="btnGuardar" text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
            <Button text="Volver a la consulta" styleClass="boton-claro" onAction="#onVolver"/>
        </HBox>
    </VBox>
</ScrollPane>
