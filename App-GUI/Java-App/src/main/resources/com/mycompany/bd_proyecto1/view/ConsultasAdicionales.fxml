<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Consultas adicionales que propuso el equipo (PKG_QUERIES_EXTRAS).
  Controlador: ConsultasAdicionalesController
  Autor: Carlos Hidalgo
  Creación: 2026-10-22
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.ConsultasAdicionalesController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Consultas adicionales" styleClass="titulo-modulo"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ====================================================================== -->
        <!-- ======================= Casas cuna con espacio ======================= -->
        <!-- ====================================================================== -->
        <Tab text="Casas cuna con espacio">
            <VBox spacing="12">
                <padding>
                    <Insets top="14" right="4" bottom="14" left="4"/>
                </padding>
                <Label styleClass="texto-secundario" wrapText="true"
                       text="Casas cuna que tienen al menos esa cantidad de espacios libres, por provincia y tipo de mascota que aceptan. Ordenadas por provincia y de más a menos espacios."/>
                <!-- ====================================================================== -->
                <!-- ============================== Filtros =============================== -->
                <!-- ====================================================================== -->

                <VBox styleClass="panel-blanco" spacing="10">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                    <GridPane hgap="12" vgap="4">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                        </columnConstraints>
                        <Label text="Provincia" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Tipo de mascota" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Espacios libres (mínimo)" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cmbProvinciaCasas" promptText="Todas" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cmbTipoCasas" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtEspacios" text="1" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <Button text="Buscar" styleClass="boton-primario" onAction="#onBuscarCasas"/>
                            <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiarCasas"/>
                        </HBox>
                    </GridPane>
                </VBox>
                <!-- ====================================================================== -->
                <!-- ============================= Resultados ============================= -->
                <!-- ====================================================================== -->

                <TableView fx:id="tblCasas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCasaPersona" text="Casa cuna de" prefWidth="200"/>
                        <TableColumn fx:id="colCasaLugar" text="Lugar" prefWidth="230"/>
                        <TableColumn fx:id="colCasaTipo" text="Acepta" prefWidth="100"/>
                        <TableColumn fx:id="colCasaEspacios" text="Espacios libres" prefWidth="110"/>
                        <TableColumn fx:id="colCasaOcupacion" text="Ocupación" prefWidth="90"/>
                        <TableColumn fx:id="colCasaEstado" text="Estado" prefWidth="100"/>
                        <TableColumn fx:id="colCasaDonacion" text="Pide alimento" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay casas cuna con ese espacio libre."/>
                    </placeholder>
                </TableView>
                <Label fx:id="lblTotalCasas" styleClass="texto-total"/>
            </VBox>
        </Tab>

        <!-- ====================================================================== -->
        <!-- ================== Mascotas perdidas por recompensa ================== -->
        <!-- ====================================================================== -->
        <Tab text="Mascotas perdidas por recompensa">
            <VBox spacing="12">
                <padding>
                    <Insets top="14" right="4" bottom="14" left="4"/>
                </padding>
                <Label styleClass="texto-secundario" wrapText="true"
                       text="Mascotas en estado &quot;Perdida&quot;, de la recompensa más alta a la más baja (las que no tienen recompensa van al final)."/>
                <!-- ====================================================================== -->
                <!-- ============================== Filtros =============================== -->
                <!-- ====================================================================== -->

                <VBox styleClass="panel-blanco" spacing="10">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                    <GridPane hgap="12" vgap="4">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <Label text="Tipo de mascota" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Provincia" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="cmbTipoPerdidas" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="cmbProvinciaPerdidas" promptText="Todas" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <HBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Button text="Buscar" styleClass="boton-primario" onAction="#onBuscarPerdidas"/>
                            <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiarPerdidas"/>
                        </HBox>
                    </GridPane>
                </VBox>
                <!-- ====================================================================== -->
                <!-- ============================= Resultados ============================= -->
                <!-- ====================================================================== -->

                <TableView fx:id="tblPerdidas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPerdNombre" text="Nombre" prefWidth="130"/>
                        <TableColumn fx:id="colPerdTipo" text="Tipo y raza" prefWidth="170"/>
                        <TableColumn fx:id="colPerdDescripcion" text="Color y tamaño" prefWidth="150"/>
                        <TableColumn fx:id="colPerdFecha" text="Perdida desde" prefWidth="100"/>
                        <TableColumn fx:id="colPerdLugar" text="Lugar" prefWidth="210"/>
                        <TableColumn fx:id="colPerdRecompensa" text="Recompensa" prefWidth="130"/>
                        <TableColumn fx:id="colPerdPersona" text="Reportada por" prefWidth="160"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay mascotas perdidas con esos criterios."/>
                    </placeholder>
                </TableView>
                <Label fx:id="lblTotalPerdidas" styleClass="texto-total"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
