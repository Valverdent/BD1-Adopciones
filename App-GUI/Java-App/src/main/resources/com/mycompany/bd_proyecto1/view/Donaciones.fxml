<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Donaciones: consulta (5.b), nueva donación (4.h) y totales por asociación (4.i).
  Controlador: DonacionesController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.DonacionesController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="grupoTipo"/>
        <ToggleGroup fx:id="grupoReparto"/>
    </fx:define>

    <Label text="Donaciones" styleClass="titulo-modulo"/>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ====================================================================== -->
        <!-- ============================== Consulta ============================== -->
        <!-- ====================================================================== -->
        <Tab text="Consulta">
            <VBox spacing="12">
                <padding><Insets top="12" right="0" bottom="0" left="0"/></padding>
                <Label styleClass="texto-secundario" wrapText="true"
                       text="Busque por cualquier combinación de campos. Los resultados se ordenan de la donación más reciente a la más antigua. Una donación repartida aparece en una fila por cada asociación."/>

                <!-- ====================================================================== -->
                <!-- ============================== Filtros =============================== -->
                <!-- ====================================================================== -->

                <VBox styleClass="panel-blanco" spacing="10">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <GridPane hgap="12" vgap="4">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <VBox fx:id="boxDonador" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Donador"/>
                            <TextField fx:id="txtDonador"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Asociación"/>
                            <ComboBox fx:id="cmbFiltroAsociacion" promptText="Todas" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Monto mínimo"/>
                            <TextField fx:id="txtMontoMinimo"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label text="Monto máximo"/>
                            <TextField fx:id="txtMontoMaximo"/>
                        </VBox>

                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Fecha desde"/>
                            <DatePicker fx:id="dpDesde" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Fecha hasta"/>
                            <DatePicker fx:id="dpHasta" maxWidth="Infinity"/>
                        </VBox>
                        <HBox spacing="8" alignment="BOTTOM_LEFT" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Button text="Buscar" styleClass="boton-primario" defaultButton="true" onAction="#onBuscar"/>
                            <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiar"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- ====================================================================== -->
                <!-- ============================= Resultados ============================= -->
                <!-- ====================================================================== -->

                <TableView fx:id="tblDonaciones" VBox.vgrow="ALWAYS" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colDonador" text="Donador" prefWidth="170"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="95"/>
                        <TableColumn fx:id="colAsociacion" text="Asociación" prefWidth="180"/>
                        <TableColumn fx:id="colPorcentaje" text="Porcentaje" prefWidth="85"/>
                        <TableColumn fx:id="colMonto" text="Monto" prefWidth="110"/>
                        <TableColumn fx:id="colMoneda" text="Moneda" prefWidth="100"/>
                        <TableColumn fx:id="colMascota" text="Mascota" prefWidth="90"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay donaciones que coincidan con la búsqueda."/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label fx:id="lblTotalRegistros" styleClass="texto-total"/>
                    <Label fx:id="lblTotalMontos" styleClass="texto-total" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnCorregir" text="Corregir monto de la seleccionada" styleClass="boton-claro" onAction="#onCorregirMonto"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- ====================================================================== -->
        <!-- =========================== Nueva donación =========================== -->
        <!-- ====================================================================== -->
        <Tab text="Nueva donación">
            <ScrollPane fitToWidth="true" styleClass="contenido">
                <VBox styleClass="contenido" spacing="12">
                    <padding><Insets top="12" right="4" bottom="12" left="0"/></padding>

                    <!-- ====================================================================== -->
                    <!-- ================================ Tipo ================================ -->
                    <!-- ====================================================================== -->
                    <VBox styleClass="panel-blanco" spacing="8">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <Label text="Tipo de donación" styleClass="seccion-titulo"/>
                        <HBox spacing="20">
                            <RadioButton fx:id="rbVoluntaria" text="Voluntaria (usted elige el monto)" toggleGroup="$grupoTipo" selected="true"/>
                            <RadioButton fx:id="rbRecompensa" text="Recompensa de una mascota" toggleGroup="$grupoTipo"/>
                        </HBox>

                        <GridPane fx:id="panelVoluntaria" hgap="12" vgap="4">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.3"/>
                                <ColumnConstraints percentWidth="33.3"/>
                                <ColumnConstraints percentWidth="33.3"/>
                            </columnConstraints>
                            <Label text="Monto *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="Moneda *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <TextField fx:id="txtMonto" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="cmbMoneda" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        </GridPane>

                        <VBox fx:id="panelRecompensa" spacing="4">
                            <Label text="Mascota con recompensa *"/>
                            <ComboBox fx:id="cmbMascotaRecompensa" promptText="Seleccione" maxWidth="Infinity"/>
                            <Label fx:id="lblRecompensa" styleClass="texto-total"/>
                            <Label fx:id="lblSinRecompensas" styleClass="texto-secundario" wrapText="true"/>
                        </VBox>

                        <GridPane hgap="12" vgap="4">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.3"/>
                            </columnConstraints>
                            <Label text="Fecha de la donación *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <DatePicker fx:id="dpFechaDonacion" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- ====================================================================== -->
                    <!-- ============================== Reparto =============================== -->
                    <!-- ====================================================================== -->
                    <VBox styleClass="panel-blanco" spacing="8">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <Label text="Asociaciones beneficiarias" styleClass="seccion-titulo"/>
                        <HBox spacing="20">
                            <RadioButton fx:id="rbUna" text="Una sola asociación" toggleGroup="$grupoReparto" selected="true"/>
                            <RadioButton fx:id="rbPorcentaje" text="Varias asociaciones por porcentaje" toggleGroup="$grupoReparto"/>
                        </HBox>
                        <HBox spacing="8" alignment="BOTTOM_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Asociación"/>
                                <ComboBox fx:id="cmbAsociacion" promptText="Seleccione" maxWidth="Infinity"/>
                            </VBox>
                            <VBox fx:id="boxPorcentaje" spacing="4">
                                <Label text="Porcentaje (%)"/>
                                <TextField fx:id="txtPorcentaje" prefWidth="110"/>
                            </VBox>
                            <Button text="Agregar" styleClass="boton-claro" onAction="#onAgregarAsociacion"/>
                        </HBox>
                        <TableView fx:id="tblReparto" prefHeight="130">
                            <columns>
                                <TableColumn fx:id="colRepartoAsociacion" text="Asociación" prefWidth="360"/>
                                <TableColumn fx:id="colRepartoPorcentaje" text="Porcentaje" prefWidth="120"/>
                            </columns>
                            <placeholder>
                                <Label text="Todavía no ha elegido asociaciones."/>
                            </placeholder>
                        </TableView>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="Quitar seleccionada" styleClass="boton-claro" onAction="#onQuitarAsociacion"/>
                            <Label fx:id="lblSumaPorcentajes" styleClass="texto-total"/>
                        </HBox>
                    </VBox>

                    <Label styleClass="texto-secundario" text="Los campos marcados con * son obligatorios."/>
                    <HBox spacing="10">
                        <Button text="Registrar donación" styleClass="boton-primario" onAction="#onRegistrar"/>
                        <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiarNueva"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ====================================================================== -->
        <!-- ======================= Totales por asociación ======================= -->
        <!-- ====================================================================== -->
        <Tab text="Totales por asociación">
            <VBox spacing="12">
                <padding><Insets top="12" right="0" bottom="0" left="0"/></padding>
                <Label styleClass="texto-secundario" wrapText="true"
                       text="Total donado a cada asociación en el rango de fechas. Por defecto, desde el inicio del año hasta hoy. Las monedas no se suman entre sí."/>
                <!-- ====================================================================== -->
                <!-- ============================== Filtros =============================== -->
                <!-- ====================================================================== -->

                <VBox styleClass="panel-blanco" spacing="10">
                    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="4">
                            <Label text="Fecha desde"/>
                            <DatePicker fx:id="dpTotalesDesde"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Fecha hasta"/>
                            <DatePicker fx:id="dpTotalesHasta"/>
                        </VBox>
                        <Button text="Consultar" styleClass="boton-primario" onAction="#onConsultarTotales"/>
                    </HBox>
                </VBox>
                <!-- ====================================================================== -->
                <!-- ============================= Resultados ============================= -->
                <!-- ====================================================================== -->

                <TableView fx:id="tblTotales" VBox.vgrow="ALWAYS" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="colTotAsociacion" text="Asociación" prefWidth="280"/>
                        <TableColumn fx:id="colTotMoneda" text="Moneda" prefWidth="130"/>
                        <TableColumn fx:id="colTotCantidad" text="Donaciones" prefWidth="100"/>
                        <TableColumn fx:id="colTotMonto" text="Total donado" prefWidth="140"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay donaciones en el rango indicado."/>
                    </placeholder>
                </TableView>
                <Label fx:id="lblTotalGeneral" styleClass="texto-total" wrapText="true"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
