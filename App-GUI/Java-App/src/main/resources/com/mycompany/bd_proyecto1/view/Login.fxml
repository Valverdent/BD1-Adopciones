<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Pantalla de inicio de sesión. El logo original del equipo se agregará cuando esté
  disponible.
  Controlador: LoginController
  Autor: Carlos Hidalgo
  Creación: 2026-10-13
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.bd_proyecto1.controller.LoginController"
           styleClass="fondo-login">

    <VBox styleClass="tarjeta-login" spacing="12" maxWidth="360" maxHeight="-Infinity">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <Label text="Bienestar Animal" styleClass="titulo-app"/>
        <Label text="Iniciar sesión" styleClass="subtitulo"/>

        <Label text="Usuario" styleClass="etiqueta-campo"/>
        <TextField fx:id="txtUsuario" promptText="Nombre de usuario"/>

        <Label text="Contraseña" styleClass="etiqueta-campo"/>
        <PasswordField fx:id="txtContrasena" promptText="Contraseña" onAction="#onIngresar"/>

        <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>

        <Button text="Ingresar" styleClass="boton-primario" defaultButton="true"
                maxWidth="Infinity" onAction="#onIngresar"/>

        <!-- Solo visible mientras se usan datos de prueba (Repositorios.FUENTE_DATOS = MEMORIA). -->
        <Label fx:id="lblModoDesarrollo" styleClass="aviso-desarrollo" wrapText="true"
               text="Modo desarrollo (datos de prueba): admin/admin, usuario/usuario, usuario2/usuario2"/>
    </VBox>
</StackPane>
