<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Consulta de mascotas: filtros combinables, tabla de resultados y totales (requisitos 4.d,
  5.a y 5.f).
  Controlador: MascotaConsultaController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.MascotaConsultaController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- ====================================================================== -->
    <!-- ============================= Encabezado ============================= -->
    <!-- ====================================================================== -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Mascotas" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Mascotas sin adoptar" styleClass="boton-claro" onAction="#onSinAdoptar"/>
        <Button text="Registrar mascota" styleClass="boton-primario" onAction="#onNueva"/>
    </HBox>
    <Label styleClass="texto-secundario" wrapText="true"
           text="Busque por cualquier combinación de campos. Los resultados se ordenan del más reciente al más antiguo."/>

    <!-- ====================================================================== -->
    <!-- ============ Filtros: cada etiqueta va encima de su campo ============ -->
    <!-- ====================================================================== -->
    <VBox styleClass="panel-blanco" spacing="10">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14"/>
        </padding>
        <GridPane hgap="12" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Raza" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label text="Color" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbTipo" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbRaza" promptText="Todas" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbEstado" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbColor" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Tamaño" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text="Chip" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Nombre" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Label text="Registrado por" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cmbTamano" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtChip" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <TextField fx:id="txtRegistradoPor" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

            <Label text="Fecha desde" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label text="Fecha hasta" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <DatePicker fx:id="dpDesde" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <DatePicker fx:id="dpHasta" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="5">
                <Button text="Buscar" styleClass="boton-primario" defaultButton="true" onAction="#onBuscar"/>
                <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiar"/>
            </HBox>
        </GridPane>
        <!-- ====================================================================== -->
        <!-- =================== Lugar del extravío o hallazgo ==================== -->
        <!-- ====================================================================== -->
        <fx:include fx:id="ubicacion" source="UbicacionCampos.fxml"/>
    </VBox>

    <!-- ====================================================================== -->
    <!-- ========== Resultados (doble clic en una fila para abrirla) ========== -->
    <!-- ====================================================================== -->
    <TableView fx:id="tblMascotas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="110"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="70"/>
            <TableColumn fx:id="colRaza" text="Raza" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="95"/>
            <TableColumn fx:id="colLugar" text="Lugar" prefWidth="170"/>
            <TableColumn fx:id="colChip" text="Chip" prefWidth="125"/>
            <TableColumn fx:id="colRecompensa" text="Recompensa" prefWidth="110"/>
            <TableColumn fx:id="colRegistradoPor" text="Registrado por" prefWidth="150"/>
        </columns>
        <placeholder>
            <Label text="No hay mascotas que coincidan con la búsqueda."/>
        </placeholder>
    </TableView>

    <!-- ====================================================================== -->
    <!-- ========================= Totales y acciones ========================= -->
    <!-- ====================================================================== -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label fx:id="lblTotalRegistros" styleClass="texto-total"/>
        <Label fx:id="lblTotalRecompensas" styleClass="texto-total" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ver / editar seleccionada" styleClass="boton-claro" onAction="#onAbrir"/>
    </HBox>
</VBox>
