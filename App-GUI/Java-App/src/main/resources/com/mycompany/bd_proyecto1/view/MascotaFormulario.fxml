<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Registro y edición de una mascota (requisitos 4.a, 4.b, 4.k y 4.m).
  Controlador: MascotaFormularioController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.bd_proyecto1.controller.MascotaFormularioController"
            fitToWidth="true" styleClass="contenido">

    <VBox styleClass="contenido" spacing="12">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label fx:id="lblTitulo" styleClass="titulo-modulo"/>
        <Label fx:id="lblRegistradoPor" styleClass="texto-secundario"/>
        <Label fx:id="lblAvisoSoloLectura" styleClass="aviso-info" wrapText="true"
               text="Solo puede ver esta mascota porque fue registrada por otra persona."/>

        <!-- Todos los campos: se deshabilitan juntos en modo solo lectura -->
        <VBox fx:id="contenedorCampos" spacing="12">

            <!-- ====================================================================== -->
            <!-- ========================== Datos generales =========================== -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Datos generales" styleClass="seccion-titulo"/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                    </columnConstraints>
                    <Label text="Tipo de mascota *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Raza *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Estado *" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbTipo" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbRaza" promptText="Primero elija el tipo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbEstado" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                    <Label text="Nombre *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label text="Chip de identificación" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Edad estimada (años)" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtNombre" promptText="Si no se conoce, uno descriptivo" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtChip" promptText="Si tiene" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtEdad" promptText="0 si es menor de un año" GridPane.columnIndex="2" GridPane.rowIndex="3"/>

                    <Label text="Color *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label text="Tamaño *" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <ComboBox fx:id="cmbColor" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="cmbTamano" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ======================== Extravío o hallazgo ========================= -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Extravío o hallazgo" styleClass="seccion-titulo"/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                    </columnConstraints>
                    <Label text="Fecha *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <Label text="Monto de recompensa" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label text="Moneda" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtMonto" promptText="Vacío si no hay recompensa" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="cmbMoneda" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
                <Label text="Lugar del extravío o hallazgo" styleClass="seccion-titulo"/>
                <fx:include fx:id="ubicacion" source="UbicacionCampos.fxml"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ============================== Contacto ============================== -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Contacto (el de la persona que registró la mascota)" styleClass="seccion-titulo"/>
                <Label fx:id="lblContacto" wrapText="true"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ========================== Características =========================== -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Características" styleClass="seccion-titulo"/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                    </columnConstraints>
                    <Label text="Severidad *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Nivel de energía *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Facilidad de entrenamiento *" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbSeveridad" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbEnergia" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbEntrenamiento" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>
                <CheckBox fx:id="chkRequiereEspacio" text="Requiere mucho espacio"/>
            </VBox>

            <!-- Salud: enfermedades de la mascota; los tratamientos y medicamentos se derivan de ellas -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Salud" styleClass="seccion-titulo"/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <Label text="Enfermedades" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Tratamientos y medicamentos (según las enfermedades)" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <HBox spacing="8">
                            <ComboBox fx:id="cmbEnfermedad" promptText="Seleccione" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="Agregar" styleClass="boton-claro" onAction="#onAgregarEnfermedad"/>
                        </HBox>
                        <ListView fx:id="lstEnfermedades" prefHeight="110"/>
                        <Button text="Quitar seleccionada" styleClass="boton-claro" onAction="#onQuitarEnfermedad"/>
                    </VBox>
                    <TextArea fx:id="txtTratamientos" editable="false" wrapText="true" prefRowCount="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Veterinario de contacto" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="cmbVeterinario" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ============================ Descripción ============================= -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Descripción" styleClass="seccion-titulo"/>
                <Label text="Situación de abandono"/>
                <TextArea fx:id="txtDescripcionAbandono" prefRowCount="2" wrapText="true"/>
                <Label text="Notas (descripción libre) *"/>
                <TextArea fx:id="txtNotas" prefRowCount="3" wrapText="true"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- =============================== Fotos ================================ -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Fotos" styleClass="seccion-titulo"/>
                <Label styleClass="texto-secundario" wrapText="true"
                       text="Pegue el enlace de una imagen publicada en internet (por ejemplo, en Imgur), que empiece con https://. Así todos la ven sin depender de un archivo de su computadora."/>
                <Label text="Foto del antes (cuando estaba en abandono)"/>
                <HBox spacing="8">
                    <TextField fx:id="txtFotoAntes" promptText="https://..." HBox.hgrow="ALWAYS"/>
                    <Button text="Vista previa" styleClass="boton-claro" onAction="#onVerFotoAntes"/>
                </HBox>
                <Label text="Foto del después (tras la recuperación)"/>
                <HBox spacing="8">
                    <TextField fx:id="txtFotoDespues" promptText="https://..." HBox.hgrow="ALWAYS"/>
                    <Button text="Vista previa" styleClass="boton-claro" onAction="#onVerFotoDespues"/>
                </HBox>
            </VBox>
        </VBox>

        <Label styleClass="texto-secundario" text="Los campos marcados con * son obligatorios."/>

        <HBox spacing="10">
            <Button fx:id="btnGuardar" text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
            <Button text="Buscar casa cuna" styleClass="boton-claro" onAction="#onBuscarCasaCuna"/>
            <Button text="Volver a la consulta" styleClass="boton-claro" onAction="#onVolver"/>
        </HBox>
    </VBox>
</ScrollPane>
