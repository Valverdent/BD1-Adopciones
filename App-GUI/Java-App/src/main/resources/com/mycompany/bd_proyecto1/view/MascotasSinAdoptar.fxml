<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Mascotas en adopción que llevan tiempo sin ser adoptadas (requisito 4.o).
  Controlador: MascotasSinAdoptarController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.MascotasSinAdoptarController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Mascotas sin adoptar" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Volver a Mascotas" styleClass="boton-claro" onAction="#onVolver"/>
    </HBox>
    <Label styleClass="texto-secundario" wrapText="true"
           text="Mascotas en estado &quot;En adopción&quot; que llevan al menos esa cantidad de meses sin ser adoptadas (el valor inicial es el del parámetro UNADOPTED_ALERT_MONTHS). Se cuentan desde la fecha del hallazgo o extravío."/>

    <!-- ====================================================================== -->
    <!-- ============================== Filtros =============================== -->
    <!-- ====================================================================== -->

    <VBox styleClass="panel-blanco" spacing="10">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14"/>
        </padding>
        <GridPane hgap="12" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <Label text="Meses sin adoptar (mínimo)" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Tipo de mascota" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <TextField fx:id="txtMeses" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbTipo" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <HBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Button text="Buscar" styleClass="boton-primario" defaultButton="true" onAction="#onBuscar"/>
                <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiar"/>
            </HBox>
        </GridPane>
    </VBox>

    <!-- ====================================================================== -->
    <!-- ============================= Resultados ============================= -->
    <!-- ====================================================================== -->

    <TableView fx:id="tblMascotas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="110"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="70"/>
            <TableColumn fx:id="colRaza" text="Raza" prefWidth="120"/>
            <TableColumn fx:id="colLugar" text="Lugar" prefWidth="150"/>
            <TableColumn fx:id="colFecha" text="Desde" prefWidth="90"/>
            <TableColumn fx:id="colDias" text="Días de espera" prefWidth="100"/>
            <TableColumn fx:id="colRegistradaPor" text="Registrada por" prefWidth="170"/>
            <TableColumn fx:id="colContacto" text="Contacto" prefWidth="170"/>
        </columns>
        <placeholder>
            <Label text="No hay mascotas sin adoptar con esos criterios."/>
        </placeholder>
    </TableView>

    <Label fx:id="lblTotalRegistros" styleClass="texto-total"/>
</VBox>
