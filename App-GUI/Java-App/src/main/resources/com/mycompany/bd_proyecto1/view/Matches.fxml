<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Reporte de matches entre mascotas perdidas y encontradas, a demanda (requisitos 5.d y 6.b).
  Controlador: MatchesController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.bd_proyecto1.controller.MatchesController"
            fitToWidth="true" styleClass="scroll-pane">
    <VBox styleClass="contenido" spacing="12">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="Matches" styleClass="titulo-modulo"/>
        <Label styleClass="texto-secundario" wrapText="true"
               text="Compara cada mascota perdida con cada mascota encontrada del mismo tipo y calcula un porcentaje según sus características. Seleccione una fila para ver los datos y fotos de ambas mascotas."/>

        <!-- ====================================================================== -->
        <!-- ======================= Generación de matches ======================== -->
        <!-- ====================================================================== -->

        <VBox styleClass="panel-blanco" spacing="10">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>
            <GridPane hgap="12" vgap="4">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <Label text="Porcentaje mínimo (0 a 100)" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Tipo de mascota" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="txtPorcentaje" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cmbTipo" promptText="Todos" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <HBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <Button text="Generar reporte" styleClass="boton-primario" defaultButton="true" onAction="#onGenerar"/>
                </HBox>
            </GridPane>
        </VBox>

        <TableView fx:id="tblMatches" prefHeight="200">
            <columns>
                <TableColumn fx:id="colPorcentaje" text="Coincidencia" prefWidth="100"/>
                <TableColumn fx:id="colPerdida" text="Mascota perdida" prefWidth="170"/>
                <TableColumn fx:id="colEncontrada" text="Mascota encontrada" prefWidth="170"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="70"/>
                <TableColumn fx:id="colCriterios" text="Características que coinciden" prefWidth="420"/>
            </columns>
            <placeholder>
                <Label text="No hay matches con esos criterios."/>
            </placeholder>
        </TableView>
        <Label fx:id="lblTotal" styleClass="texto-total"/>

        <GridPane fx:id="panelDetalle" hgap="16" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <!-- ====================================================================== -->
            <!-- ========================== Mascota perdida =========================== -->
            <!-- ====================================================================== -->

            <VBox styleClass="panel-blanco" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14"/>
                </padding>
                <Label text="Mascota perdida" styleClass="seccion-titulo"/>
                <ImageView fx:id="imgPerdida" fitWidth="220" fitHeight="160" preserveRatio="true"/>
                <Label fx:id="lblFotoPerdida" styleClass="texto-secundario"/>
                <Label fx:id="lblDatosPerdida" wrapText="true"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ========================= Mascota encontrada ========================= -->
            <!-- ====================================================================== -->

            <VBox styleClass="panel-blanco" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14"/>
                </padding>
                <Label text="Mascota encontrada" styleClass="seccion-titulo"/>
                <ImageView fx:id="imgEncontrada" fitWidth="220" fitHeight="160" preserveRatio="true"/>
                <Label fx:id="lblFotoEncontrada" styleClass="texto-secundario"/>
                <Label fx:id="lblDatosEncontrada" wrapText="true"/>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
