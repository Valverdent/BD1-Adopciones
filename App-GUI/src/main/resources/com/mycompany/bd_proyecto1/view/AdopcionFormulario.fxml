<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Registro y edición de una adopción, con calificación y seguimientos (requisitos 4.f y 4.o).
  Controlador: AdopcionFormularioController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.bd_proyecto1.controller.AdopcionFormularioController"
            fitToWidth="true" styleClass="contenido">

    <VBox styleClass="contenido" spacing="12">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label fx:id="lblTitulo" styleClass="titulo-modulo"/>
        <Label fx:id="lblEntregadaPor" styleClass="texto-secundario"/>
        <Label fx:id="lblAvisoSoloLectura" styleClass="aviso-info" wrapText="true"
               text="Solo puede ver esta adopción porque la mascota fue entregada por otra persona."/>

        <!-- Campos de la adopción: se deshabilitan juntos en modo solo lectura -->
        <VBox fx:id="contenedorCampos" spacing="12">

            <!-- ====================================================================== -->
            <!-- ======================== Mascota y adoptante ========================= -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Mascota y adoptante" styleClass="seccion-titulo"/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="40"/>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <Label text="Mascota *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Adoptante *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Fecha de adopción *" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbMascota" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbAdoptante" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>
                <Label fx:id="lblAyudaMascota" styleClass="texto-secundario" wrapText="true"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ======================= Formulario de adopción ======================= -->
            <!-- ====================================================================== -->
            <VBox fx:id="panelFormulario" styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Formulario de adopción" styleClass="seccion-titulo"/>
                <Label styleClass="texto-secundario" wrapText="true"
                       text="Las respuestas quedan en el perfil del adoptante y no se cambian después. Si la persona ya adoptó antes, se conservan las respuestas que dio la primera vez."/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                        <ColumnConstraints percentWidth="33.3"/>
                    </columnConstraints>
                    <Label text="Tipo de vivienda *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Tiempo de ejercicio *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbVivienda" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbEjercicio" promptText="Seleccione" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="chkPatio" text="La vivienda tiene patio" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                </GridPane>

                <Label text="Otras mascotas del adoptante"/>
                <HBox spacing="8">
                    <ComboBox fx:id="cmbTipoOtra" promptText="Tipo" prefWidth="140"/>
                    <ComboBox fx:id="cmbRazaOtra" promptText="Raza" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="Agregar" styleClass="boton-claro" onAction="#onAgregarOtraMascota"/>
                </HBox>
                <ListView fx:id="lstOtrasMascotas" prefHeight="90"/>
                <Button text="Quitar seleccionada" styleClass="boton-claro" onAction="#onQuitarOtraMascota"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ================= Calificación de los nuevos dueños ================== -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Calificación de los nuevos dueños" styleClass="seccion-titulo"/>
                <Label text="Calificación (la pone quien entrega la mascota)"/>
                <ComboBox fx:id="cmbCalificacion" prefWidth="200"/>
                <Label text="Notas sobre los nuevos dueños (obligatorias si califica)"/>
                <Label styleClass="texto-secundario" wrapText="true" text="La calificación se registra una sola vez."/>
                <TextArea fx:id="txtNotasCalificacion" prefRowCount="3" wrapText="true"/>
            </VBox>

            <!-- ====================================================================== -->
            <!-- ================================ Foto ================================ -->
            <!-- ====================================================================== -->
            <VBox styleClass="panel-blanco" spacing="8">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <Label text="Foto" styleClass="seccion-titulo"/>
                <Label text="Foto del adoptante con la mascota (enlace de internet)"/>
                <HBox spacing="8">
                    <TextField fx:id="txtFotoAdoptante" promptText="https://..." HBox.hgrow="ALWAYS"/>
                    <Button text="Vista previa" styleClass="boton-claro" onAction="#onVerFotoAdoptante"/>
                </HBox>
            </VBox>
        </VBox>

        <Label styleClass="texto-secundario" text="Los campos marcados con * son obligatorios."/>

        <HBox spacing="10">
            <Button fx:id="btnGuardar" text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
            <Button text="Volver a la consulta" styleClass="boton-claro" onAction="#onVolver"/>
        </HBox>

        <!-- ====================================================================== -->
        <!-- ========== Seguimientos: solo para adopciones ya guardadas =========== -->
        <!-- ====================================================================== -->
        <VBox fx:id="panelSeguimientos" styleClass="panel-blanco" spacing="8">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
            <Label text="Seguimiento de la mascota" styleClass="seccion-titulo"/>
            <TableView fx:id="tblSeguimientos" prefHeight="160">
                <columns>
                    <TableColumn fx:id="colFechaSeguimiento" text="Fecha" prefWidth="90"/>
                    <TableColumn fx:id="colComentario" text="Comentario" prefWidth="380"/>
                    <TableColumn fx:id="colFotoSeguimiento" text="Foto de la nueva vida" prefWidth="220"/>
                </columns>
                <placeholder>
                    <Label text="Todavía no hay seguimientos."/>
                </placeholder>
            </TableView>
            <Label fx:id="lblTotalSeguimientos" styleClass="texto-total"/>
            <Label text="Haga doble clic en un seguimiento para ver su foto." styleClass="texto-secundario"/>

            <VBox fx:id="panelNuevoSeguimiento" spacing="4">
                <Label text="Nuevo seguimiento" styleClass="seccion-titulo"/>
                <GridPane hgap="12" vgap="4">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="75"/>
                    </columnConstraints>
                    <Label text="Fecha *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Comentario *" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dpFechaSeguimiento" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtComentarioSeguimiento" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
                <Label text="Foto de la nueva vida * (enlace de internet)"/>
                <HBox spacing="8">
                    <TextField fx:id="txtFotoSeguimiento" promptText="https://..." HBox.hgrow="ALWAYS"/>
                    <Button text="Vista previa" styleClass="boton-claro" onAction="#onVerFotoSeguimiento"/>
                </HBox>
                <HBox>
                    <Button text="Agregar seguimiento" styleClass="boton-primario" onAction="#onAgregarSeguimiento"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
