<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Administración de asociaciones de bienestar animal (requisito 4.i). Solo administrador.
  Controlador: AsociacionesController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.AsociacionesController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Asociaciones" styleClass="titulo-modulo"/>
    <Label styleClass="texto-secundario" wrapText="true"
           text="Asociaciones de bienestar animal que pueden recibir donaciones. Seleccione una fila para editarla."/>

    <!-- ====================================================================== -->
    <!-- ============================= Resultados ============================= -->
    <!-- ====================================================================== -->

    <TableView fx:id="tblAsociaciones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="320"/>
            <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="360"/>
        </columns>
        <placeholder>
            <Label text="Todavía no hay asociaciones registradas."/>
        </placeholder>
    </TableView>
    <Label fx:id="lblTotalRegistros" styleClass="texto-total"/>

    <!-- ====================================================================== -->
    <!-- ======================= Datos de la asociación ======================= -->
    <!-- ====================================================================== -->

    <VBox styleClass="panel-blanco" spacing="8">
        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
        <Label fx:id="lblTituloFormulario" styleClass="seccion-titulo"/>
        <Label text="Nombre *"/>
        <TextField fx:id="txtNombre"/>
        <fx:include fx:id="ubicacion" source="UbicacionCampos.fxml"/>
        <HBox spacing="10">
            <Button text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
            <Button text="Nueva asociación" styleClass="boton-claro" onAction="#onNueva"/>
        </HBox>
    </VBox>
</VBox>
