<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Lista negra de adoptantes: una fila por persona reportada.
  Controlador: ListaNegraController
  Autor: Carlos Hidalgo
  Creación: 2026-10-20
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.bd_proyecto1.controller.ListaNegraController"
      styleClass="contenido" spacing="12">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Lista negra" styleClass="titulo-modulo"/>
    <Label styleClass="texto-secundario" wrapText="true"
           text="Personas reportadas por incumplir con el cuidado de una mascota. Para reportar a alguien, abra su ficha en el módulo Personas. Doble clic en una fila abre su detalle."/>

    <!-- ====================================================================== -->
    <!-- ============================== Filtros =============================== -->
    <!-- ====================================================================== -->

    <VBox styleClass="panel-blanco" spacing="10">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14"/>
        </padding>
        <GridPane hgap="12" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="34"/>
                <ColumnConstraints percentWidth="22"/>
                <ColumnConstraints percentWidth="22"/>
                <ColumnConstraints percentWidth="22"/>
            </columnConstraints>
            <Label text="Nombre de la persona" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Reportado desde" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Reportado hasta" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpDesde" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpHasta" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <Button text="Buscar" styleClass="boton-primario" defaultButton="true" onAction="#onBuscar"/>
                <Button text="Limpiar" styleClass="boton-claro" onAction="#onLimpiar"/>
            </HBox>
        </GridPane>
    </VBox>

    <!-- ====================================================================== -->
    <!-- ============================= Resultados ============================= -->
    <!-- ====================================================================== -->

    <TableView fx:id="tblListaNegra" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPersona" text="Persona" prefWidth="260"/>
            <TableColumn fx:id="colReportes" text="Reportes" prefWidth="90"/>
            <TableColumn fx:id="colUltimo" text="Último reporte" prefWidth="130"/>
            <TableColumn fx:id="colPromedio" text="Calificación promedio" prefWidth="160"/>
        </columns>
        <placeholder>
            <Label text="No hay personas en la lista negra con esos criterios."/>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label fx:id="lblTotalRegistros" styleClass="texto-total"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ver detalle de la seleccionada" styleClass="boton-claro" onAction="#onAbrir"/>
    </HBox>
</VBox>
